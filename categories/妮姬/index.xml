&lt;script&gt;
function calculateDrops() {
    var stage = document.getElementById(&#34;stage-select&#34;).value;
    
    var config = {
        &#34;7&#34;: { dropRate: 0.65, box: 0.45, key: 6 },
        &#34;8&#34;: { dropRate: 0.67, box: 0.47, key: 6 },
        &#34;9&#34;: { dropRate: 0.69, box: 0.50, key: 6 }
    };
    
    var current = config[stage];
    
    var coeff = 1.309; 
    var modDay = coeff * (3 * current.dropRate);
    var modMonth = modDay * 34;
    
    var partDay = current.box * 3;
    var partMonth = partDay * 34;
    
    var totalDay = modDay + partDay;
    var totalMonth = modMonth + partMonth;
    
    var keyDay = current.key * 3;
    var keyMonth = keyDay * 34;
    
    document.getElementById(&#34;mod-day&#34;).innerText = modDay.toFixed(2);
    document.getElementById(&#34;mod-month&#34;).innerText = modMonth.toFixed(2);
    
    document.getElementById(&#34;part-day&#34;).innerText = partDay.toFixed(2);
    document.getElementById(&#34;part-month&#34;).innerText = partMonth.toFixed(2);
    
    document.getElementById(&#34;total-day&#34;).innerText = totalDay.toFixed(2);
    document.getElementById(&#34;total-month&#34;).innerText = totalMonth.toFixed(2);
    
    document.getElementById(&#34;key-day&#34;).innerText = keyDay.toFixed(0); 
    document.getElementById(&#34;key-month&#34;).innerText = keyMonth.toFixed(0);
}

window.onload = function() {
    calculateDrops();
};
&lt;/script&gt;
